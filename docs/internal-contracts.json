{
  "status": "Matches the team service contract and documents the accepted-contact context sent by Search.",
  "userToken": {
    "format": "shared/auth.js signToken and verifyToken using TOKEN_SECRET",
    "subject": "users.id UUID",
    "role": [
      "student",
      "alumni",
      "admin"
    ],
    "expiry": "required numeric exp"
  },
  "browser": {
    "sessionStorageKey": "token",
    "pages": [
      "profile.html",
      "privacy.html"
    ],
    "identityOwner": "Daniel",
    "localDemoSessionStorageKey": "alumnilink.accessToken"
  },
  "calls": [
    {
      "caller": "Profile",
      "receiver": "Identity",
      "method": "GET",
      "path": "/internal/users/:id/status",
      "response": {
        "id": "UUID matching requested user",
        "role": "alumni | student | admin",
        "accountStatus": "active | suspended | pending | rejected"
      },
      "headers": {
        "X-Service-Key": "SERVICE_KEY"
      }
    },
    {
      "caller": "Profile",
      "receiver": "Locations",
      "method": "POST",
      "path": "/internal/locations/resolve",
      "request": {
        "location": "Cairo"
      },
      "response": {
        "location": {
          "name": "Cairo",
          "country": "Egypt",
          "latitude": 30,
          "longitude": 31
        },
        "cached": true
      },
      "failure": "400 unresolved input, 503 outage or malformed result. Profile changes remain uncommitted.",
      "headers": {
        "X-Service-Key": "SERVICE_KEY"
      },
      "storage": "Save the submitted location text that Search uses for its cache key."
    },
    {
      "caller": "Search",
      "receiver": "Profile",
      "method": "GET",
      "path": "/internal/profiles/:id/contact?requestId=:requestId",
      "headers": {
        "X-Service-Key": "SERVICE_KEY",
        "X-User-Token": "Sender's original signed user token, verified independently",
        "X-Request-Id": "Optional UUID propagated into logs"
      },
      "response": {
        "profileId": "profile UUID",
        "contactEmail": "string or null"
      },
      "checks": [
        "valid service credential",
        "valid delegated Student or Alumni token",
        "current sender role and active status verified via Identity",
        "contact_requests.student_user_id matches token sub",
        "sender and recipient are different accounts",
        "contact_requests.alumni_profile_id matches path",
        "contact_requests.status is accepted",
        "profile is_active true",
        "recipient Alumni account currently active",
        "recheck consent and both accounts in the final database query"
      ]
    }
  ],
  "privacy": {
    "fields": [
      "graduation_year",
      "company",
      "location",
      "industry",
      "bio",
      "skills"
    ],
    "defaultVisible": false,
    "contactEmail": "accepted-contact workflow only",
    "enforcementOwner": "Ammar must apply visibility to both directory responses and filters"
  },
  "deactivation": {
    "profile": "Ahmed updates alumni_profiles.is_active",
    "account": "Daniel updates users.account_status"
  },
  "schema": {
    "locationsId": "integer",
    "skillsId": "integer",
    "accountEligibility": "active",
    "contactRequestColumns": [
      "id",
      "student_user_id",
      "alumni_profile_id",
      "status"
    ]
  }
}
